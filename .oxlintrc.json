{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "oxc",
    "react",
    "typescript",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ],
  "rules": {
    "unicorn/no-array-fill-with-reference-type": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "__APP_VERSION__"
        ]
      }
    ]
  }
}
